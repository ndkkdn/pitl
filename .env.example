# PITL 환경변수 템플릿 — `cp .env.example .env` 후 필요한 값만 채우세요 (.env는 커밋 금지)
# 생성 엔진은 로컬 Claude CLI(`claude -p`)를 사용합니다. 사전에 `claude` 로그인이 필요합니다.

# (선택) claude 실행 파일 경로 — PATH에 없을 때만 지정
CLAUDE_BIN=
# (선택) 사용할 모델 — 비우면 Claude CLI 기본 모델 (예: opus, sonnet)
CLAUDE_MODEL=
# (선택) 호출당 타임아웃(ms), 기본 600000 (10분)
CLAUDE_TIMEOUT_MS=

# (선택) 네이버 뉴스 검색 API: https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 서버 포트 (기본 7878)
PORT=7878
# 예전 포트(4000) 주소의 브라우저 기록을 옮기기 위해 함께 여는 포트 (옮긴 뒤 0으로 끄면 됨)
LEGACY_PORT=4000
# GitHub Pages 등 웹에서 연 PITL 화면이 이 로컬 서버를 쓰도록 허용할 origin (쉼표로 여러 개, 비우면 로컬 화면만 허용)
ALLOWED_ORIGINS=https://ndkkdn.github.io

# 기획서 아카이브 자동 게시 (GitHub Pages)
# 분석이 끝난 기획서를 아래 저장소에 커밋해 게시합니다. 공개 저장소라면 기획서가 공개됩니다.
ARCHIVE_REPO=ndkkdn/artifactarchives
ARCHIVE_BRANCH=main
# 자동 게시를 끄려면 false (타일 대시보드의 '아카이브에 게시' 버튼은 계속 사용 가능)
ARCHIVE_AUTO_PUBLISH=true
# (선택) GitHub 토큰 — 비우면 로그인된 gh CLI 토큰(gh auth token)을 사용
GITHUB_TOKEN=
